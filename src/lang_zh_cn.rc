// Simplified Chinese translation (UTF-8, included from deskpins.rc).

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED


//
// Dialogs
//

IDD_ABOUT DIALOGEX 0, 0, 212, 79
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 DeskPins"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_APP,IDC_LOGO,4,4,20,20
    LTEXT           DP_ABOUT_TEXT_ZH_CN,IDC_STATIC,32,4,124,26,NOT WS_GROUP
    RTEXT           "已用图钉：",IDC_STATIC,32,36,52,8
    LTEXT           "0",IDC_STATUS,88,36,40,8,NOT WS_GROUP
    LTEXT           "邮箱：",IDC_STATIC,4,52,24,8,NOT WS_GROUP
    CONTROL         "<a href=""mailto:efotinis@gmail.com"">efotinis@gmail.com</a>",IDC_MAIL,"SysLink",WS_TABSTOP,28,52,128,8
    LTEXT           "网站：",IDC_STATIC,4,62,24,8,NOT WS_GROUP
    CONTROL         "<a href=""https://efotinis.neocities.org/deskpins/"">DeskPins 主页</a>",IDC_WEB,"SysLink",WS_TABSTOP,28,62,128,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDVERT,160,-4,1,84
    PUSHBUTTON      "确定",IDOK,168,4,38,14,BS_CENTER,WS_EX_STATICEDGE
END

IDD_EDIT_AUTOPIN_RULE DIALOGEX 0, 0, 220, 97
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "编辑规则"
FONT 9, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    GROUPBOX        "规则",IDC_STATIC,4,4,212,64
    LTEXT           "描述(&D)",IDC_STATIC,12,18,44,8
    EDITTEXT        IDC_DESCR,60,16,128,12,ES_AUTOHSCROLL
    LTEXT           "标题(&T)",IDC_STATIC,12,34,44,8
    EDITTEXT        IDC_TITLE,60,32,128,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_TTLPICK,192,32,16,12,SS_NOTIFY | NOT WS_GROUP
    LTEXT           "类名(&C)",IDC_STATIC,12,50,44,8
    EDITTEXT        IDC_CLASS,60,48,128,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_CLSPICK,192,48,16,12,SS_NOTIFY | NOT WS_GROUP
    DEFPUSHBUTTON   "确定",IDOK,52,76,50,14
    PUSHBUTTON      "取消",IDCANCEL,108,76,50,14
    PUSHBUTTON      "帮助",IDHELP,164,76,50,14
END

IDD_OPT_PINS DIALOGEX 0, 0, 212, 156
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "图钉"
FONT 9, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    GROUPBOX        "图钉图标",IDC_STATIC,8,8,196,52
    LTEXT           "颜色",IDC_STATIC,16,24,44,8
    PUSHBUTTON      "更改(&C)...",IDC_PIN_COLOR,68,20,64,14
    LTEXT           "",IDC_PIN_COLOR_BOX,136,21,28,13,SS_NOTIFY | SS_SUNKEN
    LTEXT           "跟踪频率(&T)",IDC_STATIC,16,42,50,8
    EDITTEXT        IDC_POLL_RATE,68,40,40,12,ES_NUMBER
    CONTROL         "",IDC_POLL_RATE_UD,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,96,40,11,11
    LTEXT           "毫秒",IDC_STATIC,116,42,22,8,NOT WS_GROUP
    GROUPBOX        "托盘图标激活方式(&A)",IDC_STATIC,8,68,196,40,WS_GROUP
    CONTROL         "单击",IDC_TRAY_SINGLE_CLICK,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,16,80,80,10
    CONTROL         "双击",IDC_TRAY_DOUBLE_CLICK,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,16,92,80,10
    GROUPBOX        "系统",IDC_STATIC,8,116,196,32,WS_GROUP
    CONTROL         "开机时自动运行",IDC_RUN_ON_STARTUP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,132,120,10
END

IDD_OPT_AUTOPIN DIALOGEX 0, 0, 212, 145
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "自动固定"
FONT 9, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    GROUPBOX        "",IDC_AUTOPIN_GROUP,8,8,196,128
    CONTROL         "启用(&N)",IDC_AUTOPIN_ON,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,8,44,10
    CONTROL         "",IDC_LIST,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,20,24,112,84
    PUSHBUTTON      "添加(&A)...",IDC_ADD,144,24,50,14
    PUSHBUTTON      "删除(&R)",IDC_REMOVE,144,40,50,14
    PUSHBUTTON      "编辑(&E)...",IDC_EDIT,144,56,50,14
    PUSHBUTTON      "上移(&U)",IDC_UP,144,76,50,14
    PUSHBUTTON      "下移(&D)",IDC_DOWN,144,92,50,14
    LTEXT           "延迟(&L)",IDC_STATIC,20,118,30,8
    EDITTEXT        IDC_RULE_DELAY,52,116,40,12,ES_NUMBER
    CONTROL         "",IDC_RULE_DELAY_UD,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,80,116,11,11
    LTEXT           "毫秒",IDC_STATIC,96,118,22,8,NOT WS_GROUP
END

IDD_OPT_HOTKEYS DIALOGEX 0, 0, 212, 97
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "热键"
FONT 9, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    GROUPBOX        "",IDC_HOTKEYS_GROUP,8,8,196,80
    CONTROL         "启用(&E)",IDC_HOTKEYS_ON,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,8,44,10
    LTEXT           "进入放置图钉模式(&M)",IDC_STATIC,16,24,120,8,NOT WS_GROUP
    CONTROL         "",IDC_HOT_PINMODE,"msctls_hotkey32",WS_BORDER | WS_TABSTOP,16,36,180,12
    LTEXT           "切换当前窗口的固定状态(&T)",IDC_STATIC,16,56,140,8,NOT WS_GROUP
    CONTROL         "",IDC_HOT_TOGGLEPIN,"msctls_hotkey32",WS_BORDER | WS_TABSTOP,16,68,180,12
END

IDD_OPT_LANG DIALOGEX 0, 0, 212, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "语言"
FONT 9, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    GROUPBOX        "界面(&I)",IDC_STATIC,8,8,196,40
    COMBOBOX        IDC_UILANG,16,24,180,100,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "帮助(&H)",IDC_STATIC,8,56,196,40
    COMBOBOX        IDC_HELPLANG,16,72,180,100,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_SORT | WS_VSCROLL | WS_TABSTOP
END


//
// Menu
//

IDM_TRAY MENU
BEGIN
    POPUP "(tray)"
    BEGIN
        MENUITEM "放置图钉(&E)",                CM_NEWPIN
        MENUITEM "移除所有图钉(&R)",            CM_REMOVEPINS
        MENUITEM SEPARATOR
        MENUITEM "选项(&O)...",                 CM_OPTIONS
        MENUITEM SEPARATOR
        MENUITEM "帮助(&H)",                    IDHELP
        MENUITEM "关于(&A)",                    CM_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "退出 DeskPins(&C)",           CM_CLOSE
    END
END



IDC_REMOVEPIN           CURSOR                  "res/removepin.cur"
IDC_BULLSEYE            CURSOR                  "res/bullseye.cur"

IDI_APP                 ICON                    "res/app.ico"

IDB_PIN                 BITMAP                  "res/pin.bmp"



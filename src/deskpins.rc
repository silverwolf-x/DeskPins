#pragma code_page(65001)

#include "resource.h"
#include "dp_version.h"
#ifndef DP_VERSION_MAJOR
#error "dp_version.h not found or incomplete"
#endif
#include <winres.h>
#include <commctrl.h>


LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US


//
// Dialogs
//

IDD_ABOUT DIALOGEX 0, 0, 212, 79
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About DeskPins"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_APP,IDC_LOGO,4,4,20,20
    LTEXT           DP_ABOUT_TEXT,IDC_STATIC,32,4,124,24,NOT WS_GROUP
    RTEXT           "Pins used:",IDC_STATIC,32,36,52,8
    LTEXT           "0",IDC_STATUS,88,36,40,8,NOT WS_GROUP
    LTEXT           "Email:",IDC_STATIC,4,52,20,8,NOT WS_GROUP
    CONTROL         "<a href=""mailto:efotinis@gmail.com"">efotinis@gmail.com</a>",IDC_MAIL,"SysLink",WS_TABSTOP,24,52,130,8
    LTEXT           "Web:",IDC_STATIC,4,60,20,8,NOT WS_GROUP
    CONTROL         "<a href=""https://efotinis.neocities.org/deskpins/"">DeskPins webpage</a>",IDC_WEB,"SysLink",WS_TABSTOP,24,60,130,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDVERT,160,-4,1,84
    PUSHBUTTON      "OK",IDOK,168,4,38,14,BS_CENTER,WS_EX_STATICEDGE
END

IDD_EDIT_AUTOPIN_RULE DIALOGEX 0, 0, 220, 97
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit Rule"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    GROUPBOX        "Rule",IDC_STATIC,4,4,212,64
    LTEXT           "&Description",IDC_STATIC,12,18,44,8
    EDITTEXT        IDC_DESCR,60,16,128,12,ES_AUTOHSCROLL
    LTEXT           "&Title",IDC_STATIC,12,34,20,8
    EDITTEXT        IDC_TITLE,60,32,128,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_TTLPICK,192,32,16,12,SS_NOTIFY | NOT WS_GROUP
    LTEXT           "&Class",IDC_STATIC,12,50,20,8
    EDITTEXT        IDC_CLASS,60,48,128,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_CLSPICK,192,48,16,12,SS_NOTIFY | NOT WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,52,76,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,108,76,50,14
    PUSHBUTTON      "Help",IDHELP,164,76,50,14
END

IDD_OPT_PINS DIALOGEX 0, 0, 212, 156
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Pins"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    GROUPBOX        "Pin Icon",IDC_STATIC,8,8,196,52
    LTEXT           "Color",IDC_STATIC,16,24,17,8
    PUSHBUTTON      "&Change...",IDC_PIN_COLOR,68,20,64,14
    LTEXT           "",IDC_PIN_COLOR_BOX,136,21,28,13,SS_NOTIFY | SS_SUNKEN
    LTEXT           "&Tracking rate",IDC_STATIC,16,42,43,8
    EDITTEXT        IDC_POLL_RATE,68,40,40,12,ES_NUMBER
    CONTROL         "",IDC_POLL_RATE_UD,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,96,40,11,11
    LTEXT           "msec",IDC_STATIC,116,42,22,8,NOT WS_GROUP
    GROUPBOX        "Tray Icon &Activation",IDC_STATIC,8,68,196,40,WS_GROUP
    CONTROL         "Single click",IDC_TRAY_SINGLE_CLICK,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,16,80,52,8
    CONTROL         "Double click",IDC_TRAY_DOUBLE_CLICK,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,16,92,56,8
    GROUPBOX        "System",IDC_STATIC,8,116,196,32,WS_GROUP
    CONTROL         "Run on system startup",IDC_RUN_ON_STARTUP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,132,93,10
END

IDD_OPT_AUTOPIN DIALOGEX 0, 0, 212, 145
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Autopin"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    GROUPBOX        "",IDC_AUTOPIN_GROUP,8,8,196,128
    CONTROL         "E&nable",IDC_AUTOPIN_ON,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,8,38,10
    CONTROL         "",IDC_LIST,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,20,24,112,84
    PUSHBUTTON      "&Add...",IDC_ADD,144,24,50,14
    PUSHBUTTON      "&Remove",IDC_REMOVE,144,40,50,14
    PUSHBUTTON      "&Edit...",IDC_EDIT,144,56,50,14
    PUSHBUTTON      "Move &Up",IDC_UP,144,76,50,14
    PUSHBUTTON      "Move &Down",IDC_DOWN,144,92,50,14
    LTEXT           "De&lay",IDC_STATIC,20,118,19,8
    EDITTEXT        IDC_RULE_DELAY,52,116,40,12,ES_NUMBER
    CONTROL         "",IDC_RULE_DELAY_UD,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,80,116,11,11
    LTEXT           "msec",IDC_STATIC,96,118,22,8,NOT WS_GROUP
END

IDD_OPT_HOTKEYS DIALOGEX 0, 0, 212, 97
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Hotkeys"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    GROUPBOX        "",IDC_HOTKEYS_GROUP,8,8,196,80
    CONTROL         "&Enable",IDC_HOTKEYS_ON,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,8,38,10
    LTEXT           "Enter pin &mode",IDC_STATIC,16,24,52,8,NOT WS_GROUP
    CONTROL         "",IDC_HOT_PINMODE,"msctls_hotkey32",WS_BORDER | WS_TABSTOP,16,36,180,12
    LTEXT           "&Toggle active window pin",IDC_STATIC,16,56,92,8,NOT WS_GROUP
    CONTROL         "",IDC_HOT_TOGGLEPIN,"msctls_hotkey32",WS_BORDER | WS_TABSTOP,16,68,180,12
END

IDD_OPT_LANG DIALOGEX 0, 0, 212, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Language"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    GROUPBOX        "&Interface",IDC_STATIC,8,8,196,40
    COMBOBOX        IDC_UILANG,16,24,180,100,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "&Help",IDC_STATIC,8,56,196,40
    COMBOBOX        IDC_HELPLANG,16,72,180,100,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_SORT | WS_VSCROLL | WS_TABSTOP
END


//
// Menu
//

IDM_TRAY MENU
BEGIN
    POPUP "(tray)"
    BEGIN
        MENUITEM "&Enter pin mode",             CM_NEWPIN
        MENUITEM "&Remove all pins",            CM_REMOVEPINS
        MENUITEM SEPARATOR
        MENUITEM "&Options...",                 CM_OPTIONS
        MENUITEM SEPARATOR
        MENUITEM "&Help",                       IDHELP
        MENUITEM "&About",                      CM_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "&Close DeskPins",             CM_CLOSE
    END
END


//
// Language-neutral resources (shared by all translations)
//

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL


//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DP_VERSION_MAJOR,DP_VERSION_MINOR,DP_VERSION_PATCH,0
 PRODUCTVERSION DP_VERSION_MAJOR,DP_VERSION_MINOR,DP_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Freeware"
            VALUE "CompanyName", "Elias Fotinis"
            VALUE "FileDescription", "DeskPins"
            VALUE "FileVersion", DP_VERSION_STR
            VALUE "InternalName", "DeskPins.exe"
            VALUE "LegalCopyright", "Copyright (C) 2002-2015 Elias Fotinis"
            VALUE "OriginalFilename", "DeskPins.exe"
            VALUE "ProductName", "DeskPins"
            VALUE "ProductVersion", DP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


//
// Cursors, icons, bitmaps
